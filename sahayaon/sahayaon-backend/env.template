# Firebase Configuration
# IMPORTANT: project_id must match the Firebase project used by the frontend
# Frontend uses: ticketingtoolv2 (see sahayaon-frontend/src/config/firebase.js)
type=service_account
project_id=ticketingtoolv2
private_key_id=your-private-key-id
private_key="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
client_email=your-service-account@your-project.iam.gserviceaccount.com
client_id=your-client-id
auth_uri=https://accounts.google.com/o/oauth2/auth
token_uri=https://oauth2.googleapis.com/token
auth_provider_x509_cert_url=https://www.googleapis.com/oauth2/v1/certs
client_x509_cert_url=https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project.iam.gserviceaccount.com
universe_domain=googleapis.com

# Firebase Storage
# IMPORTANT: Must match the project_id above
FIREBASE_STORAGE_BUCKET=ticketingtoolv2.firebasestorage.app

# Email Configuration (for sending emails)
# EMAIL_TRANSPORT: Set to "GMAIL" for Gmail, "OUTLOOK" for Office365, or leave empty for auto-detect
# Auto-detection: Gmail (gmail.com/googlemail.com), Outlook (outlook.com/office365.com/hotmail.com/microsoft.com)
EMAIL_TRANSPORT=GMAIL
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
DISTRIBUTION_EMAIL=support@yourdomain.com

# For Office365/Outlook (only needed if EMAIL_TRANSPORT=OUTLOOK or using custom SMTP)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Email-to-Ticket Configuration (for receiving emails and creating tickets)
ENABLE_EMAIL_TO_TICKET=false
TICKET_EMAIL_USER=tickets@yourdomain.com
TICKET_EMAIL_PASSWORD=your-ticket-email-password
TICKET_EMAIL_HOST=outlook.office365.com
TICKET_EMAIL_PORT=993
EMAIL_POLL_INTERVAL_MINUTES=5

# Server Configuration
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://ticketingtoolv2.web.app



